# Credentials for the opt-in live test suite (`pytest -m live`) only.
#
# Nothing in the library or the default (offline) test run loads this file or
# needs any of these values. Copy it to `tests/.env`, fill in real credentials,
# and load it before running the live tests, e.g.:
#
#     set -a; source tests/.env; set +a
#     pytest -m live
#
# `tests/.env` is git-ignored so the secrets never leave your machine.

# Required by the OpenRouter live tests (and the live tracing tests).
OPENROUTER_API_KEY=sk-or-v1-...

# Langfuse tracing live tests (tests/core/test_tracing_live.py). BASE_URL
# defaults to https://cloud.langfuse.com when unset.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Second Langfuse project — only the multi-project routing live test needs these.
# LANGFUSE_PUBLIC_KEY_2=
# LANGFUSE_SECRET_KEY_2=
