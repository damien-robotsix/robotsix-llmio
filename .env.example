# OpenRouter API key — required by OpenRouterProvider (and derived providers).
OPENROUTER_API_KEY=sk-or-v1-...

# Langfuse tracing (optional) — uncomment and fill to enable trace/cost export.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PROJECT_ID=

# LLM provider backend — selects the default backend for get_provider()
# when no explicit provider= argument is given.
# Known values: openrouter-deepseek (default), claude-sdk
# LLMIO_PROVIDER=openrouter-deepseek
