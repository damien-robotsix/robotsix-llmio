# OpenRouter API key — required by OpenRouterProvider (and derived providers).
OPENROUTER_API_KEY=sk-or-v1-...

# Langfuse tracing (optional) — uncomment and fill to enable trace/cost export.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PROJECT_ID=

# Level-based LLM configuration (optional) — uncomment to override the baked
# defaults read by config.loader. Each level has a model and an optional
# JSON object of provider kwargs.
#
# Level 1 (defaults: openrouter[deepseek]-deepseek/deepseek-v4-flash)
# LLMIO_LEVEL1_MODEL=openrouter[deepseek]-deepseek/deepseek-v4-flash
# LLMIO_LEVEL1_PROVIDER_KWARGS={"base_url": "..."}
#
# Level 2 (defaults: openrouter[deepseek]-deepseek/deepseek-v4-pro)
# LLMIO_LEVEL2_MODEL=openrouter[deepseek]-deepseek/deepseek-v4-pro
# LLMIO_LEVEL2_PROVIDER_KWARGS={"base_url": "..."}
#
# Level 3 (defaults: claudeSDK-opus)
# LLMIO_LEVEL3_MODEL=claudeSDK-opus
# LLMIO_LEVEL3_PROVIDER_KWARGS={}

# Logging (optional) — uncomment to override defaults (INFO / console).
# LOG_LEVEL=INFO
# LOG_FORMAT=console

